{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accessibility & Localization Spec",
  "type": "object",
  "required": [
    "locales",
    "subtitles",
    "input_remap",
    "reduced_motion",
    "text_expansion_test",
    "screen_reader_labels"
  ],
  "properties": {
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "subtitles": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "speaker_labels": {
          "type": "boolean"
        },
        "critical_sound_captions": {
          "type": "boolean"
        }
      }
    },
    "input_remap": {
      "type": "boolean"
    },
    "reduced_motion": {
      "type": "boolean"
    },
    "text_expansion_test": {
      "type": "number",
      "minimum": 1
    },
    "screen_reader_labels": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
