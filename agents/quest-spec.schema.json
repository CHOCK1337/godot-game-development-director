{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quest Spec",
  "type": "object",
  "required": [
    "quest_id",
    "start_node",
    "nodes",
    "edges",
    "fail_states",
    "save_keys"
  ],
  "properties": {
    "quest_id": {
      "type": "string",
      "minLength": 1
    },
    "start_node": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "objective",
              "choice",
              "dialogue",
              "gate",
              "event",
              "terminal"
            ]
          },
          "localization_key": {
            "type": "string"
          },
          "state_writes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "condition"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "fail_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "save_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
