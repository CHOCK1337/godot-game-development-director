{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Level Spec",
  "type": "object",
  "required": [
    "experience_goal",
    "level_type",
    "player_capabilities",
    "topology",
    "critical_path",
    "intensity_curve",
    "hard_invariants",
    "playtest_hypotheses"
  ],
  "properties": {
    "experience_goal": {
      "type": "string",
      "minLength": 10
    },
    "level_type": {
      "type": "string"
    },
    "player_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "topology": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "bidirectional": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "critical_path": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "optional_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "value": {
            "type": "string"
          },
          "rejoins": {
            "type": "boolean"
          }
        }
      }
    },
    "intensity_curve": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "segment",
          "intensity"
        ],
        "properties": {
          "segment": {
            "type": "string"
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose"
        ]
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hard_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "playtest_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "hypothesis",
          "measure",
          "falsifier"
        ]
      }
    }
  }
}
