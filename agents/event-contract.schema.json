{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gameplay Event Contract",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "producer",
          "timing",
          "consumers",
          "dedupe",
          "fallback"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
          },
          "producer": {
            "type": "string"
          },
          "timing": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "dedupe": {
            "type": "string"
          },
          "fallback": {
            "type": "string"
          }
        }
      }
    }
  }
}
